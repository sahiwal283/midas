# OCR Engine Configuration
#
# Safe local defaults: no network calls, no paid providers, no database required.
# See ../../docs/OCR_ENGINE.md for the full provider matrix and cost implications.

ENVIRONMENT=development
SERVICE_NAME=midas-ocr-engine

# ── OCR Providers ─────────────────────────────────────────────────────────────
# tesseract | rapidocr | easyocr are free and run locally — safe defaults.
# document_ai | google_vision are metered cloud providers and cost money per call.
# Never set PRIMARY_OCR_PROVIDER to a paid provider outside of production, and
# never without explicit operator approval (see docs/ocr-integration.md).
PRIMARY_OCR_PROVIDER=rapidocr
FALLBACK_OCR_PROVIDER=tesseract
OCR_CONFIDENCE_THRESHOLD=0.6

# ── File handling ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/tmp/ocr_uploads

# ── Service-to-service auth ───────────────────────────────────────────────────
# Required in any environment reachable from outside localhost. Generate with:
#   openssl rand -hex 32
# Must match OCR_SERVICE_INTERNAL_TOKEN in the calling Midas API's .env.
OCR_REQUIRE_SERVICE_TOKEN=false
OCR_SERVICE_INTERNAL_TOKEN=

# ── Cost ledger (optional; required only when PRIMARY/FALLBACK use paid providers) ──
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/ocr_ledger
REQUIRE_COST_LEDGER=false

# ── LLM enhancement (optional, off by default) ────────────────────────────────
ENABLE_LLM_INFERENCE=false
LLM_PROVIDER=ollama
# OLLAMA_URL=http://ollama:11434

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list. Only the Midas API needs to reach this service directly;
# it is never called from a browser.
CORS_ORIGINS=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_OCR_RESULTS=true

# ── Admin UI (optional; leave OCR_ADMIN_INTERNAL_TOKEN unset to disable /admin/*) ──
OCR_ADMIN_INTERNAL_TOKEN=
