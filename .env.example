# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=midas
POSTGRES_USER=midas
POSTGRES_PASSWORD=change_me

# ── Auth ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Use different secrets per environment.
JWT_SECRET=change_me_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=30d

# ── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECURE=false          # true in production (requires HTTPS)
# COOKIE_DOMAIN=             # set to shared domain for cross-service cookies

# ── Integration modes: mock | service ────────────────────────────────────────
# OCR is live by default (service). mock is only for offline unit tests / CI
# without network access — never use mock as the operational default.
# Zoho remains mock until explicitly approved for live writes.
OCR_MODE=service
ZOHO_MODE=mock
STORAGE_MODE=local           # local | s3 (future)

# ── OCR (live) ───────────────────────────────────────────────────────────────
# Trade Show App and Midas share the same live OCR engine on CT 9500.
# The full OCR *pipeline* is NOT only that container — Midas also runs
# ImageMagick preprocessing + rule-based field inference in @midas/ocr-client
# (same as Trade Show's receiptExternalOcr.ts). See docs/OCR_ENGINE.md.
#
# Production / LAN (same host Trade Show uses):
OCR_BASE_URL=http://192.168.1.195:8000
# Local alternative (image must be built first, see docs/OCR_ENGINE.md): docker compose --profile ocr up -d ocr-engine
# then OCR_BASE_URL=http://localhost:8001
#
# Service-to-service auth token — must match the live OCR engine's
# OCR_SERVICE_INTERNAL_TOKEN (CT 9500 requires it). Never commit the real value.
OCR_SERVICE_INTERNAL_TOKEN=
# Match Trade Show App's OCR_TIMEOUT (2 minutes). Cloud fallback can be slow.
OCR_TIMEOUT_MS=120000
# Cost attribution headers sent with every OCR request (defaults are correct for Midas).
# OCR_CLIENT_APP=midas
# OCR_WORKFLOW=receipt-ocr
# OCR_EXTERNAL_REF_TYPE=expense_receipt

# Deprecated aliases — use the names above for new deployments.
# These are still accepted but will be removed in a future version.
# OCR_SERVICE_URL=      (use OCR_BASE_URL)
# OCR_SERVICE_TOKEN=    (use OCR_SERVICE_INTERNAL_TOKEN)

# ── Zoho Integration Service (used when ZOHO_MODE=service) ───────────────────
# Base URL of the shared Zoho Integration Service. LAN production: http://192.168.1.205:8000
ZOHO_SERVICE_BASE_URL=
# App credential issued by the Zoho Integration Service admin for this Midas instance.
# Obtain via POST /admin/apps/{app_id}/credentials on the integration service.
# Never commit this value.
ZOHO_SERVICE_TOKEN=
# Brand identifier for Zoho Books org selection. Must match a brand registered in the service.
ZOHO_DEFAULT_BRAND=haute_brands
# Dry-run gate: when true, Midas logs the Zoho payload but never POSTs to the service.
# Must be explicitly set to false before enabling live Zoho writes.
ZOHO_DRY_RUN=true
# Deprecated — use ZOHO_SERVICE_BASE_URL for new deployments.
# ZOHO_SERVICE_URL=

# ── Web push notifications (optional) ─────────────────────────────────────────
# Generate once per environment: `npx web-push generate-vapid-keys`.
# Push delivery is silently disabled unless both keys are set.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact URI reported to browser push services (mailto: or https:).
# VAPID_SUBJECT=mailto:admin@midas.local

# ── Auth mode ─────────────────────────────────────────────────────────────────
# local     — bcrypt login only (default, safe for pilot)
# authentik — Authentik OIDC SSO; configure vars below
AUTH_MODE=local

# Set true to allow local password login as a break-glass path when AUTH_MODE=authentik
# ALLOW_LOCAL_BREAK_GLASS=false

# ── Authentik OIDC (required when AUTH_MODE=authentik) ────────────────────────
# Global issuer URL returned by Authentik (NOT the per-app path).
# AUTHENTIK_ISSUER_URL=https://auth.booute.duckdns.org/

# Per-app OIDC discovery endpoint (optional; recommended for Authentik).
# AUTHENTIK_DISCOVERY_URL=https://auth.booute.duckdns.org/application/o/midas/.well-known/openid-configuration

# From Authentik UI → Applications → Providers → midas → OAuth2 settings.
# AUTHENTIK_CLIENT_ID=
# AUTHENTIK_CLIENT_SECRET=          # server-side only, never expose to browser

# Where Authentik sends the user after auth. Must match the allowed redirect URIs in Authentik.
# LAN production: http://192.168.1.210:4000/api/v1/auth/oidc/callback
# AUTHENTIK_REDIRECT_URI=http://192.168.1.210:4000/api/v1/auth/oidc/callback

# Where to send the user after OIDC logout. Typically the web app login page.
# AUTHENTIK_POST_LOGOUT_REDIRECT_URI=http://192.168.1.210:5173/login

# OAuth2 scopes (default: openid profile email — Authentik sends groups via the groups scope)
# AUTHENTIK_SCOPES=openid profile email

# Authentik group names that map to Midas roles. Highest-privilege wins when user is in multiple.
# These must match Authentik group names exactly (case-sensitive).
# AUTHENTIK_GROUP_ADMIN=app-midas-admins
# AUTHENTIK_GROUP_ACCOUNTANT=app-midas-accountants
# AUTHENTIK_GROUP_USER=app-midas-users

# Auto-provision Midas users on first SSO sign-in.
# When true: a Midas user record is created automatically on first successful SSO login,
# provided the Authentik user is in at least one approved Midas group.
# Users with no approved Midas group are always denied, regardless of this flag.
# When false: admins must pre-create users in Admin → Users before they can SSO in.
# AUTHENTIK_AUTO_CREATE_USERS=false

# Ext API: auto-create Midas users by email on mutating Ext calls when missing.
# Default false (prod prefers preflight). Sandbox: set true.
EXT_AUTO_PROVISION_USERS=false

# Absolute web origin used in Ext midasUrl links (Trade Show "Open in Midas").
# Defaults to CORS_ORIGIN when unset.
# MIDAS_WEB_BASE_URL=http://192.168.x.x:5173

# Bind address — 0.0.0.0 required for LAN access (e.g. CT 2600 → Midas API).
# HOST=0.0.0.0

# Max JSON body for Ext import batches with base64 receipts (default 100mb).
# JSON_BODY_LIMIT=100mb

# ── Auth rate limiting ────────────────────────────────────────────────────────
# Max login attempts per 15-minute window per source IP.
# Default 20 is appropriate for production (brute-force protection).
# Set to 200 for dev/LAN to avoid operator lockout during testing.
AUTH_RATE_LIMIT_MAX=20

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to the URL browsers use to reach the web UI.
# On LAN: use the host's IP (e.g. http://192.168.1.210:5173)
# In prod with a domain: http://midas.example.com
CORS_ORIGIN=http://localhost:5173

# Optional: pin browser-extension origins for credentialed CORS.
# Comma-separated full origins (chrome-extension://ID) or bare Chrome extension IDs.
# Empty (default) = allow any chrome-extension:// / moz-extension:// origin (LAN/beta).
# Production should set this once the unpacked/store extension ID is stable.
# EXTENSION_ORIGIN_ALLOWLIST=

# ── Frontend (Docker internal — not browser-facing) ───────────────────────────
# Used by the Vite dev server proxy. Must be the Docker service name inside the network.
# Do not set this to a LAN IP — the proxy runs server-side inside Docker.
VITE_API_URL=http://api:4000

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOADS_DIR=/app/uploads
