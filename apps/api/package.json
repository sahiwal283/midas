{
  "name": "@midas/api",
  "version": "1.8.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:sql": "tsx --env-file=../../.env src/db/runSqlMigrations.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "drizzle-kit push --force && tsx --env-file=../../.env src/db/seed.ts",
    "import:run": "tsx --env-file=../../.env src/scripts/run-import.ts",
    "ext:create-connection": "tsx --env-file=../../.env src/scripts/create-ext-connection.ts",
    "ext:smoke": "tsx --env-file=../../.env src/scripts/ext-smoke.ts",
    "zoho:smoke": "tsx --env-file=../../.env src/scripts/zoho-smoke.ts",
    "recover:admin-pw": "tsx --env-file=../../.env src/scripts/reset-admin-pw.ts",
    "recover:merge-users": "tsx --env-file=../../.env src/scripts/merge-users.ts",
    "recover:company-state": "tsx --env-file=../../.env src/scripts/repair-company-integration-state.ts"
  },
  "dependencies": {
    "@midas/import": "*",
    "@midas/ocr-client": "*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "heic-convert": "^2.1.0",
    "helmet": "^8.0.0",
    "jose": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@midas/shared": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
