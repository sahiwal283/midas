# Midas test credentials — required by scripts/verify-workflows.sh
#
# Copy this file to scripts/.env.test (gitignored) and fill in real values.
# Never commit real passwords to this file or any other tracked file.
#
# Usage:
#   source scripts/.env.test && bash scripts/verify-workflows.sh

# Email defaults match the seed users; override if accounts were renamed.
MIDAS_TEST_ADMIN_EMAIL=admin@midas.local
MIDAS_TEST_ADMIN_PASSWORD=

MIDAS_TEST_USER_EMAIL=user@midas.local
MIDAS_TEST_USER_PASSWORD=

MIDAS_TEST_ACCOUNTANT_EMAIL=accountant@midas.local
MIDAS_TEST_ACCOUNTANT_PASSWORD=
